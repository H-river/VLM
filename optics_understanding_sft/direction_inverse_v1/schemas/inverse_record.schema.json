{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["example_id", "group_id", "split", "task_type", "prompt_inputs", "target"],
  "properties": {
    "example_id": {"type": "string"},
    "group_id": {"type": "string"},
    "split": {"enum": ["train", "val", "eval_iid", "eval_ood"]},
    "task_type": {"enum": ["inverse_action_numeric", "inverse_action_visual"]},
    "prompt_inputs": {
      "type": "object",
      "required": ["setup", "action_grid", "matching_tolerance", "images"]
    },
    "target": {
      "type": "object",
      "required": ["status", "answer"],
      "properties": {
        "status": {"enum": ["unique", "ambiguous", "infeasible_within_limits"]}
      }
    }
  },
  "additionalProperties": true
}
