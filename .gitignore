!/artifacts/README.md
!/artifacts/manifests/
!/artifacts/manifests/**

!/results/
/results/*
!/results/README.md
!/results/published_tables/
!/results/published_tables/**

# Full locally generated optics-understanding pilot. Keep source, fixtures, and
