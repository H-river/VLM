{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuous_control_v12/manifest_v12.schema.json",
  "title": "V12 dataset manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "schema_version",
    "complete",
    "units",
    "output_order",
    "tolerances",
    "feature_definitions",
    "generator",
    "seeds",
    "split_hashes",
    "split_summary",
    "coverage",
    "absolute_limit_source",
    "q_star_deployed_input"
  ],
  "properties": {
    "version": {
      "enum": [
        "continuous_control_v12",
        "continuous_control_v12_semantics_v1",
        "continuous_control_v12_semantics_v1_data_quality_v2"
      ]
    },
    "schema_version": {"enum": ["v12.0.0", "v12.1.0"]},
    "complete": {"const": true},
    "units": {"type": "object"},
    "output_order": {
      "const": [
        "centroid_x_px",
        "centroid_y_px",
        "sigma_x_px",
        "sigma_y_px",
        "peak_intensity"
      ]
    },
    "tolerances": {"type": "object"},
    "feature_definitions": {"type": "object"},
    "generator": {"type": "object"},
    "seeds": {"type": "object"},
    "split_hashes": {"type": "object"},
    "split_summary": {"type": "object"},
    "coverage": {"type": "object"},
    "absolute_limit_source": {"type": "string"},
    "q_star_deployed_input": {"const": false},
    "simulator_semantics_version": {"type": "string"},
    "sensor_sampling_method": {"type": "string"},
    "power_semantics": {"type": "string"},
    "intensity_normalization": {"type": "string"},
    "power_affects_current_simulator": {"type": "boolean"}
  }
}
