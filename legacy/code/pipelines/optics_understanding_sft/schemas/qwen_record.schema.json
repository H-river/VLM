  "properties": {
    "example_id": {"type": "string"},
    "group_id": {"type": "string"},
    "task_type": {"type": "string"},
    "images": {"type": "array", "items": {"type": "string"}},
    "prompt": {"type": "array"},
    "completion": {"type": "array"}
  },
  "additionalProperties": false
}
