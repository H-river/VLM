{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qwen_orchestration_decision_v1",
  "title": "Qwen orchestration decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "task_type",
    "route_name",
    "arguments",
    "image_roles",
    "missing_fields",
    "clarification_question"
  ],
  "properties": {
    "schema_version": {
      "const": "qwen_orchestration_decision_v1"
    },
    "status": {
      "enum": ["ready", "needs_clarification", "unsupported"]
    },
    "task_type": {
      "type": ["string", "null"],
      "enum": [
        "beam_profile_measurement",
        "direction_prediction",
        "forward_prediction",
        "inverse_control",
        null
      ]
    },
    "route_name": {
      "type": ["string", "null"],
      "enum": [
        "measure_beam_profile_v1",
        "predict_direction_from_state_v1",
        "predict_direction_from_image_v1",
        "predict_forward_from_state_v1",
        "predict_forward_from_image_v1",
        "select_inverse_action_from_states_v1",
        "select_inverse_action_from_images_v1",
        null
      ]
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setup": {"$ref": "#/$defs/setup"},
        "current_beam_state": {"$ref": "#/$defs/beam_state"},
        "desired_beam_state": {"$ref": "#/$defs/beam_state"},
        "action": {"$ref": "#/$defs/action"},
        "image_calibration": {"$ref": "#/$defs/image_calibration"}
      }
    },
    "image_roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beam": {"$ref": "#/$defs/image_reference"},
        "current_beam": {"$ref": "#/$defs/image_reference"},
        "desired_beam": {"$ref": "#/$defs/image_reference"}
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "clarification_question": {
      "type": ["string", "null"],
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "ready"}}
      },
      "then": {
        "properties": {
          "task_type": {"type": "string"},
          "route_name": {"type": "string"},
          "missing_fields": {"maxItems": 0},
          "clarification_question": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "needs_clarification"}}
      },
      "then": {
        "properties": {
          "route_name": {"type": "null"},
          "missing_fields": {"minItems": 1},
          "clarification_question": {"type": "string"}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "unsupported"}}
      },
      "then": {
        "properties": {
          "task_type": {"type": "null"},
          "route_name": {"type": "null"},
          "arguments": {"maxProperties": 0},
          "image_roles": {"maxProperties": 0},
          "missing_fields": {"maxItems": 0},
          "clarification_question": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "finite_number": {
      "type": "number"
    },
    "image_reference": {
      "type": "string",
      "pattern": "^image_[0-9]+$"
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wavelength_nm",
        "beam_waist_mm",
        "power_w",
        "lens_focal_length_mm",
        "lens_aperture_mm",
        "source_to_lens_mm",
        "lens_to_camera_mm",
        "lens_x_offset_mm",
        "lens_y_offset_mm",
        "camera_x_offset_mm",
        "camera_y_offset_mm",
        "pixel_size_um"
      ],
      "properties": {
        "wavelength_nm": {"$ref": "#/$defs/finite_number"},
        "beam_waist_mm": {"$ref": "#/$defs/finite_number"},
        "power_w": {"$ref": "#/$defs/finite_number"},
        "lens_focal_length_mm": {"$ref": "#/$defs/finite_number"},
        "lens_aperture_mm": {"$ref": "#/$defs/finite_number"},
        "source_to_lens_mm": {"$ref": "#/$defs/finite_number"},
        "lens_to_camera_mm": {"$ref": "#/$defs/finite_number"},
        "lens_x_offset_mm": {"$ref": "#/$defs/finite_number"},
        "lens_y_offset_mm": {"$ref": "#/$defs/finite_number"},
        "camera_x_offset_mm": {"$ref": "#/$defs/finite_number"},
        "camera_y_offset_mm": {"$ref": "#/$defs/finite_number"},
        "pixel_size_um": {"$ref": "#/$defs/finite_number"}
      }
    },
    "beam_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "centroid_x_px",
        "centroid_y_px",
        "sigma_x_px",
        "sigma_y_px",
        "peak_intensity"
      ],
      "properties": {
        "centroid_x_px": {"$ref": "#/$defs/finite_number"},
        "centroid_y_px": {"$ref": "#/$defs/finite_number"},
        "sigma_x_px": {"$ref": "#/$defs/finite_number"},
        "sigma_y_px": {"$ref": "#/$defs/finite_number"},
        "peak_intensity": {"$ref": "#/$defs/finite_number"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lens_x_delta_mm",
        "lens_y_delta_mm",
        "camera_x_delta_mm",
        "camera_y_delta_mm"
      ],
      "properties": {
        "lens_x_delta_mm": {"$ref": "#/$defs/finite_number"},
        "lens_y_delta_mm": {"$ref": "#/$defs/finite_number"},
        "camera_x_delta_mm": {"$ref": "#/$defs/finite_number"},
        "camera_y_delta_mm": {"$ref": "#/$defs/finite_number"}
      }
    },
    "image_calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linear_intensity_low",
        "linear_intensity_high",
        "gamma",
        "source_sensor_resolution_px"
      ],
      "properties": {
        "linear_intensity_low": {"$ref": "#/$defs/finite_number"},
        "linear_intensity_high": {"$ref": "#/$defs/finite_number"},
        "gamma": {"$ref": "#/$defs/finite_number"},
        "source_sensor_resolution_px": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
