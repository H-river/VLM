[Unit]
Description=VLM v4 restart-safe training and validation pipeline
ConditionPathExists=!/home/jiamo/VLM_runs/control_rebuild_v4_one_seed/post_generation_pipeline.complete
After=vlm-numdata-v4-safe.service
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/jiamo/VLM
ExecStart=/bin/bash /home/jiamo/VLM/control_rebuild_v4/run_post_generation_pipeline.sh
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
Nice=15
IOSchedulingClass=idle
CPUQuota=50%
AllowedCPUs=8
MemoryHigh=3221225472
MemoryMax=4294967296
MemorySwapMax=268435456
TasksMax=64
Restart=on-failure
RestartSec=30
StandardOutput=append:/tmp/vlm-v4-post-generation-ccd2.log
StandardError=append:/tmp/vlm-v4-post-generation-ccd2.log
